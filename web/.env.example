# KURVV web — copy to .env.local. Never commit the real file.
#
# The demo signer lives SERVER-SIDE and is used only inside /api/demo. It must NOT
# carry the NEXT_PUBLIC_ prefix: that prefix inlines a value into the client bundle,
# which is how a key was leaked and drained once already.
DEMO_PRIVATE_KEY=

# Deployed contracts on Shannon (50312). Both are safe to expose to the client.
NEXT_PUBLIC_PLAN_BOOK=
NEXT_PUBLIC_BATCH_EXECUTOR=

# THE DEFAULT SIGNER. With an app id, Privy handles onboarding — email creates an
# embedded wallet, and "wallet" connects an existing one through Privy's own
# injected/WalletConnect handling, so there is no second integration to configure.
# WITHOUT it the app falls back to the demo signing path above.
NEXT_PUBLIC_PRIVY_APP_ID=

# Gas drip, OFF unless set to exactly "1".
#
# A fresh embedded wallet has no STT, so it cannot pay for its first commit (~0.072
# STT at 6 gwei). With this on, /api/demo will top an address up to 0.25 STT from the
# demo key — once: an address already above 0.05 STT is refused, so it is a top-up
# rather than a payout. Server-side and deliberately not NEXT_PUBLIC_.
DEMO_FUND_GAS=

# WHERE THE ART LIVES. Empty (or unset) serves from this repo's public/ directory,
# which is what a fresh checkout and the tests use. Point it at a CDN origin and every
# sheet moves with it, because nothing else in the codebase writes an asset path.
#
# The origin MUST send `Access-Control-Allow-Origin`. Sheets are loaded with
# crossOrigin="anonymous", and a canvas that has drawn one image without CORS is
# tainted and throws on toDataURL — which is what /play's share button calls.
NEXT_PUBLIC_ASSET_BASE=https://kurvv-assets.vercel.app
